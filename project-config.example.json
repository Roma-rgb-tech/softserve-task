{
  "default_cloud": "gcp",
  "default_region": "us-east",
  "catalog": {
    "size": {
      "gcp": {
        "micro": "e2-micro",
        "small": "e2-small",
        "medium": "e2-medium"
      },
      "aws": {
        "micro": "t3.micro",
        "small": "t3.small",
        "medium": "t3.medium"
      }
    },
    "disk_type": {
      "gcp": {
        "standard": "pd-standard",
        "balanced": "pd-balanced",
        "ssd": "pd-ssd"
      },
      "aws": {
        "standard": "gp2",
        "balanced": "gp3",
        "ssd": "io2"
      }
    },
    "region": {
      "gcp": {
        "us-east": "us-east1",
        "eu-west": "europe-west1"
      },
      "aws": {
        "us-east": "us-east-1",
        "eu-west": "eu-west-1"
      }
    },
    "zone": {
      "gcp": {
        "us-east": "us-east1-b",
        "eu-west": "europe-west1-b"
      },
      "aws": {
        "us-east": "us-east-1a",
        "eu-west": "eu-west-1a"
      }
    },
    "os": {
      "gcp": {
        "ubuntu-26.04": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64",
        "ubuntu-24.04": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
      },
      "aws": {
        "ubuntu-26.04": "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*",
        "ubuntu-24.04": "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"
      }
    }
  },
  "environment": "dev",
  "name_prefix": "oilscope",
  "gcp": {
    "project_id": "example-project-12345",
    "secret_version_managers": [
      "user:example-operator@example.com"
    ]
  },
  "aws": {
    "regions": [
      "us-east-1"
    ],
    "secret_version_managers": [
      "arn:aws:iam::123456789012:user/example-operator"
    ]
  },
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [
      443
    ]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "size": "micro",
      "os": "ubuntu-26.04",
      "internal_ip": "10.0.0.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "bastion"
      ],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ],
      "ssh_bootstrap": false
    },
    "infra": {
      "role": "database",
      "size": "micro",
      "os": "ubuntu-26.04",
      "internal_ip": "10.0.1.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "infra"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "size": "small",
      "os": "ubuntu-26.04",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "history"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "size": "micro",
      "os": "ubuntu-26.04",
      "internal_ip": "10.0.1.6",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "fetcher"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "size": "micro",
      "os": "ubuntu-26.04",
      "internal_ip": "10.0.0.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "ui"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
