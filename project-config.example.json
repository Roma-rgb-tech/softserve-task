{
  "default_cloud": "gcp",
  "default_region": "us-east",
  "catalog": {
    "size": {
      "gcp": {
        "micro": "e2-micro",
        "small": "e2-small",
        "medium": "e2-medium"
      },
      "aws": {
        "micro": "t3.micro",
        "small": "t3.small",
        "medium": "t3.medium"
      },
      "azure": {
        "micro": "Standard_D2als_v7",
        "small": "Standard_D2as_v7",
        "medium": "Standard_D4as_v7"
      }
    },
    "disk_type": {
      "gcp": {
        "standard": "pd-standard",
        "balanced": "pd-balanced",
        "ssd": "pd-ssd"
      },
      "aws": {
        "standard": "gp2",
        "balanced": "gp3",
        "ssd": "io2"
      },
      "azure": {
        "standard": "Standard_LRS",
        "balanced": "StandardSSD_LRS",
        "ssd": "Premium_LRS"
      }
    },
    "region": {
      "gcp": {
        "us-east": "us-east1",
        "eu-west": "europe-west1"
      },
      "aws": {
        "us-east": "us-east-1",
        "eu-west": "eu-west-1"
      },
      "azure": {
        "us-east": "centralus",
        "eu-west": "northeurope"
      }
    },
    "zone": {
      "gcp": {
        "us-east": "us-east1-b",
        "eu-west": "europe-west1-b"
      },
      "aws": {
        "us-east": "us-east-1a",
        "eu-west": "eu-west-1a"
      },
      "azure": {
        "us-east": "1",
        "eu-west": "1"
      }
    },
    "os": {
      "gcp": {
        "ubuntu-26.04": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64",
        "ubuntu-24.04": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
      },
      "aws": {
        "ubuntu-26.04": "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*",
        "ubuntu-24.04": "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"
      },
      "azure": {
        "ubuntu-24.04": "Canonical:ubuntu-24_04-lts:server:latest",
        "ubuntu-26.04": "Canonical:ubuntu-26_04-lts:server:latest"
      }
    },
    "db_size": {
      "gcp": {
        "micro": "db-f1-micro",
        "small": "db-g1-small",
        "medium": "db-custom-1-3840"
      },
      "aws": {
        "micro": "db.t3.micro",
        "small": "db.t3.small",
        "medium": "db.t3.medium"
      },
      "azure": {
        "micro": "B_Standard_B1ms",
        "small": "B_Standard_B2s",
        "medium": "GP_Standard_D2s_v3"
      }
    }
  },
  "environment": "dev",
  "workspace": "default",
  "name_prefix": "oilscope",
  "gcp": {
    "project_id": "example-project-12345",
    "billing_account": "000000-000000-000000",
    "secret_version_managers": [
      "user:example-operator@example.com"
    ]
  },
  "aws": {
    "regions": [
      "us-east-1"
    ],
    "secret_version_managers": [
      "arn:aws:iam::123456789012:user/example-operator"
    ]
  },
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.10.0.0/16",
    "management_subnet_cidr": "10.10.0.0/28",
    "workload_subnet_cidr": "10.10.1.0/26",
    "ui_public_ports": [
      80,
      443
    ],
    "clouds": {
      "gcp": {
        "vpc_cidr": "10.10.0.0/16",
        "management_subnet_cidr": "10.10.0.0/28",
        "workload_subnet_cidr": "10.10.1.0/26"
      },
      "aws": {
        "vpc_cidr": "10.20.0.0/16",
        "management_subnet_cidr": "10.20.0.0/28",
        "workload_subnet_cidr": "10.20.1.0/26"
      },
      "azure": {
        "vpc_cidr": "10.30.0.0/16",
        "management_subnet_cidr": "10.30.0.0/28",
        "workload_subnet_cidr": "10.30.1.0/26"
      }
    }
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432,
    "amqp": 5672,
    "redis": 6379
  },
  "monitoring": {
    "alert_emails": [
      "alerts@example.com"
    ],
    "cpu_percent": 80,
    "memory_percent": 85,
    "disk_percent": 85,
    "error_log_threshold": 5,
    "budget": {
      "amount": 50,
      "currency": "USD",
      "thresholds": [
        0.5,
        0.9,
        1.0
      ]
    }
  },
  "generated_secrets": [
    "oilscope-dev-db-password",
    "oilscope-dev-redis-password",
    "oilscope-dev-grafana-password"
  ],
  "vms": {
    "bastion": {
      "role": "bastion",
      "size": "micro",
      "os": "ubuntu-26.04",
      "internal_ip": "10.10.0.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "bastion"
      ],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ],
      "ssh_bootstrap": false
    },
    "k3s-1": {
      "role": "k3s_server",
      "size": "medium",
      "os": "ubuntu-24.04",
      "internal_ip": "10.10.0.5",
      "boot_disk": {
        "size_gb": 30,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "k3s"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "oilscope-dev-db-password",
        "REDIS_PASSWORD": "oilscope-dev-redis-password",
        "GHCR_TOKEN": "example-ghcr-token",
        "OILPRICEAPI_KEY": "example-api-key",
        "CF_DNS_API_TOKEN": "example-cloudflare-dns-token",
        "GRAFANA_ADMIN_PASSWORD": "oilscope-dev-grafana-password"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com",
        "cloudflare_zone_id": "0123456789abcdef0123456789abcdef"
      }
    },
    "k3s-2": {
      "role": "k3s_server",
      "size": "medium",
      "os": "ubuntu-24.04",
      "internal_ip": "10.10.1.5",
      "boot_disk": {
        "size_gb": 30,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "k3s"
      ],
      "secret_mappings": {}
    },
    "k3s-3": {
      "role": "k3s_server",
      "size": "medium",
      "os": "ubuntu-24.04",
      "internal_ip": "10.10.1.6",
      "boot_disk": {
        "size_gb": 30,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "k3s"
      ],
      "secret_mappings": {}
    }
  },
  "database": {
    "managed": false,
    "database_name": "oil_tracker",
    "username": "oil_tracker",
    "password_secret": "oilscope-dev-db-password"
  },
  "sessions": {
    "backend": "redis",
    "password_secret": "oilscope-dev-redis-password"
  },
  "tailscale": {
    "tailnet": "-",
    "ephemeral": true
  },
  "k3s": {
    "version": "v1.33.4+k3s1",
    "tls_sans": []
  },
  "kubernetes": {
    "managed": true,
    "node_count": 3,
    "node_size": "medium",
    "gitops": {
      "enabled": true,
      "repo_url": "https://github.com/example-org/example-project.git",
      "revision": "main"
    }
  },
  "cluster": {
    "namespace": "oilscope",
    "internal_domain": "oilscope.internal",
    "database": {
      "instances": 2,
      "storage_gb": 5
    }
  }
}
