{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret Terraform project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "default_region",
    "catalog",
    "environment",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "service_ports",
    "vms"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "stage",
        "prod"
      ]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "username",
        "image_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "ui_public_ports",
        "vpc_cidr"
      ],
      "properties": {
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              80,
              443
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "vpc_cidr": {
          "description": "CIDR range of the VPC. AWS requires one; GCP derives its network from the subnets and ignores this value.",
          "type": "string"
        },
        "database_subnet_cidrs": {
          "description": "Ranges the managed database lives in, kept apart from the workloads. AWS spreads a DB subnet group over them and needs at least two, in different availability zones; GCP puts the Private Service Connect endpoint in the first one.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_api",
        "postgresql"
      ],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "amqp": {
          "description": "Port the message broker answers on. Used only when the database is managed, because the queue then leaves PostgreSQL and becomes a broker of its own.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "monitoring": {
      "description": "Thresholds and recipients for the alerting both clouds set up with their own native tools. Absent means no monitoring resources are created at all.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert_emails"
      ],
      "properties": {
        "alert_emails": {
          "description": "Addresses every alert is delivered to. AWS sends a confirmation link to each of them first; GCP does not.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "email",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          }
        },
        "cpu_percent": {
          "description": "Sustained CPU utilisation, in percent, that raises an alert.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 80
        },
        "memory_percent": {
          "description": "Used memory, in percent, that raises an alert. Needs the monitoring agent - neither cloud reports guest memory on its own.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 85
        },
        "disk_percent": {
          "description": "Used space on the root filesystem, in percent, that raises an alert. Needs the monitoring agent for the same reason.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 85
        },
        "error_log_threshold": {
          "description": "Number of 5xx responses within five minutes that raises an alert.",
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "budget": {
          "description": "Monthly spend alert. Both clouds mail the same recipients when a share of the amount is reached.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount"
          ],
          "properties": {
            "amount": {
              "description": "Monthly budget, in the currency below.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "description": "ISO currency code. Must be the billing account currency on GCP.",
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "USD"
            },
            "thresholds": {
              "description": "Shares of the amount that raise an alert. 0.9 means ninety percent.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    },
    "generated_secrets": {
      "description": "Containers the deployment invents a value for when the operator supplies none. Entries are container IDs used in secret_mappings. The value is made by Ansible on the first run that finds the container empty, so it never reaches Terraform configuration, plan or state.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": [
        "bastion"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "role": {
                  "const": "bastion"
                }
              },
              "required": [
                "role"
              ]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    },
    "default_region": {
      "description": "Portable region token. Terraform resolves it to a provider region and zone.",
      "type": "string",
      "enum": [
        "us-east",
        "eu-west"
      ]
    },
    "catalog": {
      "description": "Translation tables from the portable tokens used above to the values each provider expects. Terraform reads them from here rather than carrying its own copy, so any other tool reading this file resolves the same values.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "disk_type",
        "region",
        "zone",
        "os"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/catalog_table"
        },
        "disk_type": {
          "$ref": "#/$defs/catalog_table"
        },
        "region": {
          "$ref": "#/$defs/catalog_table"
        },
        "zone": {
          "$ref": "#/$defs/catalog_table"
        },
        "os": {
          "$ref": "#/$defs/catalog_table"
        },
        "db_size": {
          "$ref": "#/$defs/catalog_table"
        }
      }
    },
    "gcp": {
      "description": "Settings that exist only on GCP. Required when cloud is gcp.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "description": "Target GCP project ID.",
          "type": "string"
        },
        "billing_account": {
          "description": "Billing account the project bills to, as 000000-000000-000000. A budget lives on the billing account rather than on the project, so without this one no budget is created.",
          "type": "string",
          "pattern": "^[0-9A-F]{6}-[0-9A-F]{6}-[0-9A-F]{6}$"
        },
        "secret_version_managers": {
          "description": "IAM members allowed to add new versions to every secret. Adding a version does not grant reading one.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(user|group|serviceAccount|principal|principalSet):.+$"
          },
          "uniqueItems": true
        }
      }
    },
    "aws": {
      "description": "Settings that exist only on AWS.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regions": {
          "description": "Regions the dynamic inventory searches for this account's instances. AWS partitions resources by region, so the inventory cannot find them without one.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "secret_version_managers": {
          "description": "IAM principals allowed to add new versions to every secret. ARNs here; IAM members in the gcp section.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:(root|user/.+|role/.+)$"
          },
          "uniqueItems": true
        }
      }
    },
    "default_cloud": {
      "description": "Cloud used by every VM that does not name one of its own.",
      "type": "string",
      "enum": [
        "gcp",
        "aws"
      ]
    },
    "database": {
      "description": "Where the application's PostgreSQL lives, and with it where the queue lives. Absent, or managed set to false, keeps both in the container on the VM with role database. Managed hands PostgreSQL to the cloud - Cloud SQL or RDS - which has no PGMQ extension, so that VM runs a message broker instead and the services publish over AMQP.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed"
      ],
      "properties": {
        "managed": {
          "description": "True hands the database to the cloud provider.",
          "type": "boolean"
        },
        "engine_version": {
          "description": "Major PostgreSQL version, as both clouds accept it.",
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "storage_gb": {
          "type": "integer",
          "minimum": 10
        },
        "database_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "username": {
          "description": "Application role the services connect as. Not the administrator.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "password_secret": {
          "description": "Secret container ID holding this role's password. Ansible reads it and creates the role; the value never reaches Terraform configuration, plan or state.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "backup_retention_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35,
          "default": 7
        },
        "deletion_protection": {
          "type": "boolean",
          "default": false
        },
        "queue_password_secret": {
          "description": "Secret container holding the broker password. Required when managed, because the queue moves out of PostgreSQL and needs a credential of its own.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "queue_username": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "queue_vhost": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "description": "Cloud SQL edition. The shared-core tiers exist only in ENTERPRISE; ENTERPRISE_PLUS accepts only the performance-optimised machine types. Ignored on AWS.",
          "type": "string",
          "enum": [
            "ENTERPRISE",
            "ENTERPRISE_PLUS"
          ],
          "default": "ENTERPRISE"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "managed": {
                "const": true
              }
            },
            "required": [
              "managed"
            ]
          },
          "then": {
            "required": [
              "engine_version",
              "size",
              "storage_gb",
              "database_name",
              "username",
              "password_secret",
              "queue_username",
              "queue_password_secret"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_gb",
        "type"
      ],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "type": {
          "$ref": "#/$defs/disk_class"
        },
        "iops": {
          "description": "Provisioned IOPS. AWS requires it for the disk classes that resolve to io1 or io2, and ignores it for the rest.",
          "type": "integer",
          "minimum": 100
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "bastion",
          "infra",
          "history",
          "fetcher",
          "ui"
        ]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "network_tags",
        "secret_mappings",
        "size",
        "os"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "bastion",
            "database",
            "history",
            "fetcher",
            "ui"
          ]
        },
        "internal_ip": {
          "type": "string",
          "minLength": 1
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/vm_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostname",
            "acme_email"
          ],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "os": {
          "$ref": "#/$defs/os"
        },
        "cloud": {
          "$ref": "#/$defs/cloud"
        },
        "ci": {
          "description": "Optional first-boot work for this VM. Terraform turns it into the cloud-init document the machine is created with: a list of commands to run, a script to write and run, or both.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup_script": {
              "type": "string",
              "minLength": 1
            },
            "commands": {
              "description": "Commands run in order at first boot, before the script if there is one.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "commands"
              ]
            },
            {
              "required": [
                "startup_script"
              ]
            }
          ]
        },
        "ssh_bootstrap": {
          "description": "Temporarily allow direct SSH on port 22 while the final sshd policy is installed. Bastion only; turn off after the first deployment.",
          "type": "boolean"
        },
        "extra_disks": {
          "$ref": "#/$defs/extra_disks"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": [
              "assign_public_ip"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "enum": [
                  "bastion",
                  "ui"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "bastion"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "ssh_port",
              "allowed_cidrs"
            ],
            "properties": {
              "assign_public_ip": {
                "const": true
              },
              "network_tags": {
                "contains": {
                  "const": "bastion"
                }
              },
              "secret_mappings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ssh_port"
                  ]
                },
                {
                  "required": [
                    "allowed_cidrs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "history"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "fetcher"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ui"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "public_endpoint"
            ],
            "properties": {
              "network_tags": {
                "contains": {
                  "const": "ui"
                }
              }
            }
          }
        }
      ]
    },
    "size": {
      "description": "Portable machine size. Terraform resolves it per cloud.",
      "type": "string",
      "enum": [
        "micro",
        "small",
        "medium"
      ]
    },
    "os": {
      "description": "Portable operating system token. Terraform resolves it to an image family on GCP and to an AMI name pattern on AWS.",
      "type": "string",
      "enum": [
        "ubuntu-26.04",
        "ubuntu-24.04"
      ]
    },
    "cloud": {
      "description": "Cloud a resource is created in.",
      "type": "string",
      "enum": [
        "gcp",
        "aws"
      ]
    },
    "catalog_table": {
      "type": "object",
      "description": "Provider values keyed by cloud, then by the portable token the configuration uses.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "aws": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disk_class": {
      "description": "Portable disk class. Terraform resolves it per cloud.",
      "type": "string",
      "enum": [
        "standard",
        "balanced",
        "ssd"
      ]
    },
    "extra_disks": {
      "description": "Data disks attached beside the boot disk. Terraform creates one block per entry, and the cloud-init written for the machine formats and mounts each of them at first boot.",
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size_gb",
          "type",
          "mount_path"
        ],
        "properties": {
          "name": {
            "description": "Suffix of the disk resource name, unique within the VM.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
          },
          "size_gb": {
            "type": "integer",
            "minimum": 10
          },
          "type": {
            "$ref": "#/$defs/disk_class"
          },
          "iops": {
            "description": "Provisioned IOPS, for the classes that resolve to io1 or io2 on AWS.",
            "type": "integer",
            "minimum": 100
          },
          "mount_path": {
            "description": "Absolute path the disk is mounted at.",
            "type": "string",
            "pattern": "^/[A-Za-z0-9._/-]+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "default_cloud": {
            "const": "gcp"
          }
        },
        "required": [
          "default_cloud"
        ]
      },
      "then": {
        "required": [
          "gcp"
        ]
      }
    }
  ]
}
