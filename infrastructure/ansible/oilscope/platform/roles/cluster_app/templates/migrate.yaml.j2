---
apiVersion: batch/v1
kind: Job
metadata:
  name: migrate-{{ cluster_app_image_tag[:12] }}
  namespace: {{ cluster_app_namespace }}
spec:
  backoffLimit: 6
  template:
    metadata:
      labels:
        app.kubernetes.io/name: migrate
        app.kubernetes.io/part-of: oilscope
    spec:
      restartPolicy: OnFailure
      imagePullSecrets:
        - name: oilscope-registry
      containers:
        - name: migrate
          image: {{ cluster_app_repository }}/database:{{ cluster_app_image_tag }}
          command: ["petroscope-migrate"]
          env:
            - name: PGHOST
              value: {{ cluster_app_database_host }}
            - name: PGPORT
              value: "5432"
            - name: PGDATABASE
              value: {{ cluster_app_database_name }}
            - name: PGSSLMODE
              value: require
            - name: PGUSER
              valueFrom:
                secretKeyRef:
                  name: {{ cluster_app_database_cluster }}-app-user
                  key: username
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ cluster_app_database_cluster }}-app-user
                  key: password
          securityContext:
            allowPrivilegeEscalation: false
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
