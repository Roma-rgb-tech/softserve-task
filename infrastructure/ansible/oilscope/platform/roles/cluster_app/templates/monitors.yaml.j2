---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: oilscope
  namespace: {{ cluster_app_namespace }}
spec:
  selector:
    matchExpressions:
      - key: app.kubernetes.io/name
        operator: In
        values: [history, ui]
  endpoints:
    - port: metrics
      interval: 30s
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: fetcher
  namespace: {{ cluster_app_namespace }}
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: fetcher
  endpoints:
    - port: http
      path: /metrics
      interval: 30s
---
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: {{ cluster_app_database_cluster }}
  namespace: {{ cluster_app_namespace }}
spec:
  selector:
    matchLabels:
      cnpg.io/cluster: {{ cluster_app_database_cluster }}
  podMetricsEndpoints:
    - port: metrics
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: oilscope-dashboard
  namespace: {{ cluster_app_monitoring_namespace }}
  labels:
    grafana_dashboard: "1"
data:
  oilscope.json: |
{{ lookup('ansible.builtin.file', role_path ~ '/files/oilscope-dashboard.json') | indent(4, true) }}
