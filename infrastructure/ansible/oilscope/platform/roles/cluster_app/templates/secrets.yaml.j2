---
apiVersion: v1
kind: Secret
metadata:
  name: oilscope-registry
  namespace: {{ cluster_app_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: >-
    {{ {'auths': {cluster_app_registry_host: {
          'username': cluster_app_registry_user,
          'password': cluster_app_secrets.GHCR_TOKEN,
          'auth': (cluster_app_registry_user ~ ':' ~ cluster_app_secrets.GHCR_TOKEN) | b64encode}}}
       | to_json | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_app_database_cluster }}-app-user
  namespace: {{ cluster_app_namespace }}
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
data:
  username: {{ cluster_app_database_user | b64encode }}
  password: {{ cluster_app_secrets.POSTGRES_PASSWORD | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: oilscope-redis
  namespace: {{ cluster_app_namespace }}
type: Opaque
data:
  redis-password: {{ cluster_app_secrets.REDIS_PASSWORD | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: oilscope-app
  namespace: {{ cluster_app_namespace }}
type: Opaque
data:
  HISTORY_DATABASE_URL: >-
    {{ ('postgresql+psycopg://' ~ cluster_app_database_user ~ ':' ~ cluster_app_password_url
        ~ '@' ~ cluster_app_database_host ~ ':5432/' ~ cluster_app_database_name ~ '?sslmode=require') | b64encode }}
  FETCHER_DATABASE_URL: >-
    {{ ('postgres://' ~ cluster_app_database_user ~ ':' ~ cluster_app_password_url
        ~ '@' ~ cluster_app_database_host ~ ':5432/' ~ cluster_app_database_name ~ '?sslmode=require') | b64encode }}
  UI_DATABASE_URL: >-
    {{ ('postgresql://' ~ cluster_app_database_user ~ ':' ~ cluster_app_password_url
        ~ '@' ~ cluster_app_database_host ~ ':5432/' ~ cluster_app_database_name ~ '?sslmode=require') | b64encode }}
  REDIS_URL: >-
    {{ ('redis://:' ~ cluster_app_redis_password_url ~ '@' ~ cluster_app_redis_host ~ ':6379/0') | b64encode }}
  OILPRICEAPI_KEY: {{ cluster_app_secrets.OILPRICEAPI_KEY | b64encode }}
