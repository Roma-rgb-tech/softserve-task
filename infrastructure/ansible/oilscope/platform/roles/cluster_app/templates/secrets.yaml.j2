---
# Pulls the private images from the registry.
apiVersion: v1
kind: Secret
metadata:
  name: oilscope-registry
  namespace: {{ cluster_app_namespace }}
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: >-
    {{ {'auths': {cluster_app_registry_host: {
          'username': cluster_app_registry_user,
          'password': cluster_app_secrets.GHCR_TOKEN,
          'auth': (cluster_app_registry_user ~ ':' ~ cluster_app_secrets.GHCR_TOKEN) | b64encode}}}
       | to_json }}
---
# The application role CloudNativePG creates at bootstrap, with the password
# from the cloud secret store rather than one of its own.
apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_app_database_cluster }}-app-user
  namespace: {{ cluster_app_namespace }}
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
stringData:
  username: {{ cluster_app_database_user }}
  password: {{ cluster_app_secrets.POSTGRES_PASSWORD | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: oilscope-redis
  namespace: {{ cluster_app_namespace }}
type: Opaque
stringData:
  redis-password: {{ cluster_app_secrets.REDIS_PASSWORD | to_json }}
---
# What the services read. Each speaks to PostgreSQL through a different driver,
# so each gets its own spelling of the same connection.
apiVersion: v1
kind: Secret
metadata:
  name: oilscope-app
  namespace: {{ cluster_app_namespace }}
type: Opaque
stringData:
  HISTORY_DATABASE_URL: >-
    postgresql+psycopg://{{ cluster_app_database_user }}:{{ cluster_app_password_url }}@{{ cluster_app_database_host }}:5432/{{ cluster_app_database_name }}?sslmode=require
  FETCHER_DATABASE_URL: >-
    postgres://{{ cluster_app_database_user }}:{{ cluster_app_password_url }}@{{ cluster_app_database_host }}:5432/{{ cluster_app_database_name }}?sslmode=require
  UI_DATABASE_URL: >-
    postgresql://{{ cluster_app_database_user }}:{{ cluster_app_password_url }}@{{ cluster_app_database_host }}:5432/{{ cluster_app_database_name }}?sslmode=require
  REDIS_URL: >-
    redis://:{{ cluster_app_redis_password_url }}@{{ cluster_app_redis_host }}:6379/0
  OILPRICEAPI_KEY: {{ cluster_app_secrets.OILPRICEAPI_KEY | to_json }}
