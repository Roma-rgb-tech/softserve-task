[Unit]
Description=CoreDNS for {{ internal_dns_domain }}
Documentation=https://coredns.io
Wants=network-online.target
After=network-online.target

[Service]
ExecStart={{ internal_dns_install_dir }}/coredns -conf {{ internal_dns_config_dir }}/Corefile
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
