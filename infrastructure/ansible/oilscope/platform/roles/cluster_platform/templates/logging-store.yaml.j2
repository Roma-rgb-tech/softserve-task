# Where the logs are kept and read: one Elasticsearch node and Kibana, both
# managed by ECK. Kibana answers on plain HTTP behind Traefik, to the clouds'
# private ranges only, like Grafana; Elasticsearch keeps the TLS and the
# password ECK generates for it.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cluster_platform_logging_namespace }}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: internal-only
  namespace: {{ cluster_platform_logging_namespace }}
spec:
  ipAllowList:
    sourceRange: {{ cluster_platform_private_ranges | to_json }}
---
apiVersion: elasticsearch.k8s.elastic.co/v1
kind: Elasticsearch
metadata:
  name: logs
  namespace: {{ cluster_platform_logging_namespace }}
spec:
  version: "{{ cluster_platform_elastic_version }}"
  nodeSets:
    - name: default
      count: 1
      config:
        # No vm.max_map_count to raise on the nodes, so no privileged init
        # container; mmap only matters for large indices.
        node.store.allow_mmap: false
      podTemplate:
        spec:
          containers:
            - name: elasticsearch
              resources:
                requests:
                  cpu: 250m
                  memory: 2Gi
                limits:
                  memory: 2Gi
      volumeClaimTemplates:
        - metadata:
            name: elasticsearch-data
          spec:
            accessModes: ["ReadWriteOnce"]
            resources:
              requests:
                storage: {{ cluster_platform_logging_storage_gb | int }}Gi
---
apiVersion: kibana.k8s.elastic.co/v1
kind: Kibana
metadata:
  name: logs
  namespace: {{ cluster_platform_logging_namespace }}
spec:
  version: "{{ cluster_platform_elastic_version }}"
  count: 1
  elasticsearchRef:
    name: logs
  config:
    server.publicBaseUrl: "http://kibana.{{ cluster_platform_internal_domain }}"
  http:
    tls:
      selfSignedCertificate:
        disabled: true
  podTemplate:
    spec:
      containers:
        - name: kibana
          resources:
            requests:
              cpu: 100m
              memory: 768Mi
            limits:
              memory: 1Gi
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: kibana
  namespace: {{ cluster_platform_logging_namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    traefik.ingress.kubernetes.io/router.middlewares: {{ cluster_platform_logging_namespace }}-internal-only@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: "kibana.{{ cluster_platform_internal_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: logs-kb-http
                port:
                  number: 5601
