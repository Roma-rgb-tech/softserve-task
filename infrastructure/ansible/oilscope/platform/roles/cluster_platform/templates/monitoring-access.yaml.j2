---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cluster_platform_charts.monitoring.namespace }}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: internal-only
  namespace: {{ cluster_platform_charts.monitoring.namespace }}
spec:
  ipAllowList:
    sourceRange: {{ cluster_platform_private_ranges | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: {{ cluster_platform_charts.monitoring.namespace }}
type: Opaque
data:
  admin-user: {{ 'admin' | b64encode }}
  admin-password: {{ cluster_platform_grafana_password | b64encode }}
