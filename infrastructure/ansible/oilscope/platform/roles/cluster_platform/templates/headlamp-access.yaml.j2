---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cluster_platform_charts.headlamp.namespace }}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: internal-only
  namespace: {{ cluster_platform_charts.headlamp.namespace }}
spec:
  ipAllowList:
    sourceRange: {{ cluster_platform_private_ranges | to_json }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: headlamp-read-all
rules:
  - apiGroups: ["*"]
    resources: ["*"]
    verbs: ["get", "list", "watch"]
  - nonResourceURLs: ["*"]
    verbs: ["get"]
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: headlamp-operator
  namespace: {{ cluster_platform_charts.headlamp.namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: headlamp-operator-read-all
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: headlamp-read-all
subjects:
  - kind: ServiceAccount
    name: headlamp-operator
    namespace: {{ cluster_platform_charts.headlamp.namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: headlamp-operator-token
  namespace: {{ cluster_platform_charts.headlamp.namespace }}
  annotations:
    kubernetes.io/service-account.name: headlamp-operator
type: kubernetes.io/service-account-token
