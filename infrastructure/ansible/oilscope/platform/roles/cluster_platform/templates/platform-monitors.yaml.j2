---
# Traefik exports its metrics on the "metrics" port of every pod; the
# DaemonSet has no Service in front of that port, so the pods are scraped.
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: traefik
  namespace: {{ cluster_platform_charts.traefik.namespace }}
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: traefik
  podMetricsEndpoints:
    - port: metrics
      path: /metrics
